# --- Server-side only (Vercel project environment variables). Never prefix with VITE_. ---
# Power Automate "When an HTTP request is received" trigger URLs.
POWER_AUTOMATE_QUOTE_WEBHOOK_URL=
POWER_AUTOMATE_WHITEPAPER_WEBHOOK_URL=
POWER_AUTOMATE_NEWSLETTER_WEBHOOK_URL=

# --- Public, exposed to the browser ---
# If set, the quote section embeds Microsoft Form 1 in an iframe instead of the native form.
VITE_MS_FORM1_EMBED_URL=

# Tracking. Each tag loads only after the visitor accepts cookies.
VITE_GA4_ID=
VITE_META_PIXEL_ID=
VITE_LINKEDIN_PARTNER_ID=
VITE_LINKEDIN_CONVERSION_ID=
