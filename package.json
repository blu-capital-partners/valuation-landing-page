{
  "name": "bcp-valuation-landing",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && vite build --mode preview",
    "preview": "vite preview",
    "live": "npm run build:preview && npx --yes live-server@1.2.2 dist --host=127.0.0.1 --port=5501",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
